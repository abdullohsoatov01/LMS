# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Секретный ключ (service_role или secret key). Никогда никому не показывайте!
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Код, без которого нельзя зарегистрировать учителя на странице /setup
TEACHER_SIGNUP_CODE=придумайте-свой-код

# Любая длинная случайная строка — ей подписываются сессии
SESSION_SECRET=замените-на-длинную-случайную-строку

# Часовой пояс для подсчёта серии дней подряд
APP_TIMEZONE=Asia/Tashkent
